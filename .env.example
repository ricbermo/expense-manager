# ── Required ──
# Create a Supabase project and grab these from your project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# The email of the single authorized user (change this to your own)
ALLOWED_USER_EMAIL=your-email@example.com

# ── Required for server-side operations ──
# Your Supabase secret key (sb_secret_...) — keep this private, never expose to the browser
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# ── Optional: SMS automation via Google AI ──
# GEMINI_API_KEY=your-google-ai-studio-api-key

# ── Optional: iOS Shortcut automation ──
# SHORTCUT_API_KEY=your-shared-secret-for-ios-shortcut
# Generate with: openssl rand -hex 32
